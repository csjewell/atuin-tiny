# syntax=docker/dockerfile:1
FROM docker.io/lukemathwalker/cargo-chef:latest-rust-slim-bookworm@sha256:b4b459d305bee99c8f8200212c46276108af90b0501386e1339336c2e03c81a2 AS chef
ARG TARGETARCH
ENV ARCH=$TARGETARCH

WORKDIR /app

# Ensure working C compile setup (not installed by default in arm64 images)
RUN --mount=type=cache,sharing=locked,target=/var/cache/apt \
    --mount=type=cache,sharing=locked,target=/var/lib/apt \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade build-essential libssl-dev pkg-config wget -y

# Build with the toolchain pinned in rust-toolchain.toml, not the image's.
COPY --chmod=700 download-fig.sh /download-fig.sh
COPY atuin/rust-toolchain.toml .
RUN --mount=type=cache,id=fig,target=/usr/local/bin \
    --mount=type=cache,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,sharing=locked,target=/usr/local/cargo/git \
    /download-fig.sh \
    && rustup toolchain install --profile minimal --no-self-update "$(fig get rust-toolchain.toml toolchain.channel)" \
    && cargo install sccache --locked

ENV RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/sccache

FROM chef AS planner
COPY atuin .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json
# The recipe references the [patch.crates-io] axoasset path dependency, but
# cargo-chef does not skeleton patched crates, so the real sources are needed
COPY atuin/vendor vendor
RUN --mount=type=cache,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,sharing=locked,target=/usr/local/cargo/git \
    --mount=type=cache,sharing=locked,target=$SCCACHE_DIR \
    cargo chef cook --release --recipe-path recipe.json

COPY atuin .
RUN --mount=type=cache,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,sharing=locked,target=/usr/local/cargo/git \
    --mount=type=cache,sharing=locked,target=$SCCACHE_DIR \
    cargo build --release --bin atuin-server

# Note that this image is VERY minimal. Contains JUST ENOUGH of Debian Trixie to do the job.
# The debug image uses busybox instead of coreutils, for example.
FROM gcr.io/distroless/cc-debian13:debug-nonroot AS downloader
ARG TARGETARCH
USER root

# Get stunnel's static version of curl, and set up files to copy.
COPY --chmod=700 download-curl.sh /download-curl.sh
RUN ["/busybox/ln", "-s", "/busybox/busybox", "/bin/sh"]
ENV ARCH=$TARGETARCH
RUN /download-curl.sh \
 && adduser -D -g 'atuin user' atuin \
 && mkdir /config \
 && chown atuin:atuin /config

FROM gcr.io/distroless/cc-debian13:nonroot AS server

USER root

# Since we are not including a shell, we have to copy these files
# from somewhere that DOES.
COPY --from=downloader /etc/passwd /etc
COPY --from=downloader /etc/group /etc
COPY --from=downloader --chown=atuin:atuin /config /config
COPY --from=downloader --parents /usr/./local/bin/curl /usr
COPY --from=builder /app/target/release/atuin-server /usr/local/bin

USER atuin

WORKDIR /home/atuin

ENV TZ=Etc/UTC
ENV RUST_LOG=atuin_server=info
ENV ATUIN_CONFIG_DIR=/config

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/curl", "-fsS", "-o", "/dev/null", "http://localhost:8888/healthz"]

ENTRYPOINT ["/usr/local/bin/atuin-server"]

