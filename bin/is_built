#!/usr/bin/env bash

case "$GITHUB_EVENT_NAME" in
  push)
    echo "is_built=$(jq -r '.build' -)"
    ;;
  schedule)
    echo "is_built=$(jq -r '.buildOnSchedule' -)"
    ;;
  workflow_dispatch)
    case "$1" in
      true)
        echo "Workflow Dispatch: $1" >&2
        echo "is_built=true"
        ;;
      *)
        echo "Workflow Dispatch: $1" >&2
        echo "is_built=$(jq -r '.is_latest' -)"
        ;;
      esac
    ;;
  *)
    exit 1
    ;;
  esac
